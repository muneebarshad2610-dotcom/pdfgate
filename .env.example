# House of Games — Environment Configuration

# Discord bot token (required)
DISCORD_BOT_TOKEN=your_bot_token_here

# Database URL (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///data/house_of_games.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/house_of_games

# Bot configuration
BOT_PREFIX=/
BOT_ACTIVITY=House of Games
BOT_STATUS=online

# Admin Discord user IDs (comma-separated)
ADMIN_IDS=

# Logging level
LOG_LEVEL=INFO
